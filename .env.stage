# Build-time environment for the "stage" deploy.
# The CI renames this to .env.production before `npm run build`.
#
# CRM_API_TOKEN is deliberately absent: the pipeline appends it from a masked
# GitLab CI/CD variable so the bearer token is never committed.

# NEXT_PUBLIC_* is inlined into the bundle at build time. Must stay false here,
# or the deployed form mocks every OTP and writes no leads to the CRM.
NEXT_PUBLIC_DEBUG_MODE=false

SHIKHO_API_BASE_URL=https://api.shikho.com
CRM_API_BASE_URL=https://crm-api.shikho.com/api/v1
CRM_LOG_REF_ID=gform-web-001-0000000000001

# Optional. Leave empty to disable Google Sheets logging.
GOOGLE_SHEETS_WEBHOOK_URL=
