# ---------------------------------------------------------------------------
# Copy to .env.local and fill in.
#
# There is no .net staging tier for this system: every environment talks to
# the same .com APIs, and environments are separated by deploy target
# (Kubernetes namespace), not by hostname.
#
# There are NO hardcoded fallbacks in the code. If a URL var is unset the
# call fails loudly rather than quietly reaching a default host.
# ---------------------------------------------------------------------------

# Mocks OTP, CRM and Sheets calls; shows the debug panel.
#
# IMPORTANT: NEXT_PUBLIC_* vars are inlined into the bundle at BUILD time.
# Setting this at runtime does nothing — it must be false when `next build`
# runs, and changing it requires a rebuild.
NEXT_PUBLIC_DEBUG_MODE=false

# --- Shikho OTP API -------------------------------------------------------
SHIKHO_API_BASE_URL=https://api.shikho.com

# --- CRM API --------------------------------------------------------------
CRM_API_BASE_URL=https://crm-api.shikho.com/api/v1

# Bearer token for the CRM API. Server-side only — do NOT prefix this with
# NEXT_PUBLIC_, or it gets inlined into the browser bundle and served to
# every visitor.
CRM_API_TOKEN=

# Correlation ID sent as X-Log-Ref-Id for tracing CRM calls.
CRM_LOG_REF_ID=gform-web-001-0000000000001

# --- Google Sheets logging (optional) -------------------------------------
# Apps Script web app URL. See docs/Google_Sheets_Logging_Setup.md steps 1-3.
# Leave unset to disable logging.
GOOGLE_SHEETS_WEBHOOK_URL=
