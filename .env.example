# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Use the .net (staging) hosts for testing;
# switch to .com only when going live.
#
# There are NO hardcoded fallbacks in the code any more — if a URL var is
# unset, the call fails loudly instead of quietly hitting production.
# ---------------------------------------------------------------------------

# Mocks OTP, CRM and Sheets calls; shows the debug panel.
# MUST be false in any deployed environment.
NEXT_PUBLIC_DEBUG_MODE=true

# --- Shikho OTP API -------------------------------------------------------
# Staging:    https://api.shikho.net
# Production: https://api.shikho.com
SHIKHO_API_BASE_URL=https://api.shikho.net

# --- CRM API --------------------------------------------------------------
# Production is https://crm-api.shikho.com/api/v1
# The staging equivalent is UNCONFIRMED — crm.shikho.net is the dashboard UI,
# not the API host. Confirm the real staging API base with the CRM team.
CRM_API_BASE_URL=

# Bearer token for the CRM API. Use the STAGING token while testing.
CRM_API_TOKEN=

# Correlation ID sent as X-Log-Ref-Id for tracing CRM calls.
CRM_LOG_REF_ID=gform-web-001-0000000000001

# --- Google Sheets logging (optional) -------------------------------------
# Apps Script web app URL. See docs/Google_Sheets_Logging_Setup.md steps 1-3.
# Leave unset to disable logging entirely.
GOOGLE_SHEETS_WEBHOOK_URL=
